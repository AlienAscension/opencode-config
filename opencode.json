{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail"
  ],
  "default_agent": "build",
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/glm-5.3-flash",
  "agent": {
    "explore": { "model": "opencode-go/glm-5.3-flash" }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "*rm -rf*": "ask",
      "*rm -fr*": "ask",
      "*sudo *": "ask",
      "*git push*": "ask",
      "*git commit*": "ask",
      "*git reset --hard*": "ask",
      "*git clean -f*": "ask"
    },
    "task": {
      "*": "deny",
      "explore": "allow",
      "review": "allow",
      "general": "ask",
      "code-reviewer": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "lsp": true,
  "formatter": true
}
